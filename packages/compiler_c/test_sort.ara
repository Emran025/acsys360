برنامج ترتيب_مصفوفة_بالمعاملات؛

نوع مصفوفة_اعداد = قائمة[5] من صحيح؛

متغير الأصلية: مصفوفة_اعداد؛
متغير نسخة_العمل: مصفوفة_اعداد؛

إجراء اقرأ_المصفوفة(بالمرجع مصفوفة_إدخال: مصفوفة_اعداد)؛
متغير ث: صحيح؛
متغير قيمة_مؤقتة: صحيح؛
{
  كرر(ث = 0 الى 4 أضف 1) {
    اقرأ(قيمة_مؤقتة)؛
    مصفوفة_إدخال[ث] = قيمة_مؤقتة؛
  }؛
}؛

إجراء انسخ_المصفوفة(بالقيمة المصدر: مصفوفة_اعداد؛ بالمرجع الهدف: مصفوفة_اعداد)؛
متغير ث: صحيح؛
{
  كرر(ث = 0 الى 4 أضف 1) {
    الهدف[ث] = المصدر[ث]؛
  }؛
}؛

إجراء اطبع_المصفوفة(بالقيمة عناصر: مصفوفة_اعداد)؛
متغير ث: صحيح؛
{
  كرر(ث = 0 الى 4 أضف 1) {
    اطبع(عناصر[ث])؛
  }؛
}؛

إجراء رتب_المصفوفة(بالمرجع عناصر_للفرز: مصفوفة_اعداد)؛
متغير ث_الخارجي: صحيح؛
متغير ت_الداخلي: صحيح؛
متغير قيمة_مؤقتة: صحيح؛
{
  كرر(ث_الخارجي = 0 الى 3 أضف 1) {
    كرر(ت_الداخلي = 0 الى 3 أضف 1) {
      إذا(عناصر_للفرز[ت_الداخلي] > عناصر_للفرز[ت_الداخلي + 1]) فان {
        قيمة_مؤقتة = عناصر_للفرز[ت_الداخلي]؛
        عناصر_للفرز[ت_الداخلي] = عناصر_للفرز[ت_الداخلي + 1]؛
        عناصر_للفرز[ت_الداخلي + 1] = قيمة_مؤقتة؛
      }؛
    }؛
  }؛
}؛

{
  اقرأ_المصفوفة(الأصلية)؛
  انسخ_المصفوفة(الأصلية، نسخة_العمل)؛
  اطبع("قبل الترتيب:")؛
  اطبع_المصفوفة(نسخة_العمل)؛
  رتب_المصفوفة(نسخة_العمل)؛
  اطبع("بعد الترتيب التصاعدي:")؛
  اطبع_المصفوفة(نسخة_العمل)؛
}.