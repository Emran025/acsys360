{
  "name": "acsys360 Flutter Desktop",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "FLUTTER_VERSION": "3.32.5"
    }
  },
  "workspaceFolder": "/workspace/acsys360",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ]
    }
  },
  "postCreateCommand": "flutter pub get",
  "remoteUser": "root"
}
