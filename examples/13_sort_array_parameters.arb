برنامج ترتيب_مصفوفة_بالمعاملات؛

نوع مصفوفة_اعداد = قائمة[5] من صحيح؛

متغير الأصلية: مصفوفة_اعداد؛
متغير نسخة_العمل: مصفوفة_اعداد؛

إجراء اقرأ_المصفوفة(بالمرجع مصفوفة_إدخال: مصفوفة_اعداد؛ بالقيمة ث_الإدخال: صحيح = 0؛ بالقيمة قيمة_مؤقتة_الإدخال: صحيح = 0)؛
{
  اطبع("أدخل خمسة أعداد صحيحة:")؛
  كرر(ث_الإدخال = 0 الى 4 أضف 1) {
    اطبع("العدد رقم", ث_الإدخال + 1)؛
    اقرأ(قيمة_مؤقتة_الإدخال)؛
    مصفوفة_إدخال[ث_الإدخال] = قيمة_مؤقتة_الإدخال؛
  }؛
}؛

إجراء انسخ_المصفوفة(بالقيمة المصدر: مصفوفة_اعداد؛ بالمرجع الهدف: مصفوفة_اعداد؛ بالقيمة ث_النسخ: صحيح = 0)؛
{
  كرر(ث_النسخ = 0 الى 4 أضف 1) {
    الهدف[ث_النسخ] = المصدر[ث_النسخ]؛
  }؛
}؛

إجراء اطبع_المصفوفة(بالقيمة عناصر: مصفوفة_اعداد؛ بالقيمة ث_الطباعة: صحيح = 0)؛
{
  كرر(ث_الطباعة = 0 الى 4 أضف 1) {
    اطبع(عناصر[ث_الطباعة])؛
  }؛
}؛

إجراء رتب_المصفوفة(بالمرجع عناصر_للفرز: مصفوفة_اعداد؛ بالقيمة ث_الخارجي: صحيح = 0؛ بالقيمة ت_الداخلي: صحيح = 0؛ بالقيمة قيمة_مؤقتة_الفرز: صحيح = 0)؛
{
  // ترتيب تصاعدي بطريقة الفقاعات.
  كرر(ث_الخارجي = 0 الى 3 أضف 1) {
    كرر(ت_الداخلي = 0 الى 3 أضف 1) {
      إذا(عناصر_للفرز[ت_الداخلي] > عناصر_للفرز[ت_الداخلي + 1]) فان {
        قيمة_مؤقتة_الفرز = عناصر_للفرز[ت_الداخلي]؛
        عناصر_للفرز[ت_الداخلي] = عناصر_للفرز[ت_الداخلي + 1]؛
        عناصر_للفرز[ت_الداخلي + 1] = قيمة_مؤقتة_الفرز؛
      }؛
    }؛
  }؛
}؛

{
  اقرأ_المصفوفة(الأصلية)؛
  انسخ_المصفوفة(الأصلية، نسخة_العمل)؛
  اطبع("قبل الترتيب:")؛
  اطبع_المصفوفة(نسخة_العمل)؛
  رتب_المصفوفة(نسخة_العمل)؛
  اطبع("بعد الترتيب التصاعدي:")؛
  اطبع_المصفوفة(نسخة_العمل)؛
}.
